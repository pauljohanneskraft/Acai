    "Intent.GetCodebaseMetrics.Description" : {
      "comment" : "What the Get Metrics action does.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gibt Typen- und Modulanzahl, höchste Komplexität, Zyklen, toten Code und Health-Score einer Codebase zurück, ohne Açaí zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Answers with a codebase's type and module counts, highest complexity, cycles, dead code and health score, without opening Açaí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Renvoie le nombre de types et de modules, la complexité maximale, les cycles, le code mort et le score de santé d’une codebase, sans ouvrir Açaí."
          }
        }
      }
    },
    "Intent.GetCodebaseMetrics.Summary ${codebase}" : {
      "comment" : "The Get Metrics action as it reads in a Shortcut; ${codebase} is the codebase picked.",
