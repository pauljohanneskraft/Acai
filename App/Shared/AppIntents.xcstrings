    "Intent.RunQualityCheck.Description" : {
      "comment" : "What the Run Quality Check action does.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Führt die Qualitätsprüfung einer Codebase aus und gibt zurück, ob sie bestanden wurde und wie viele Befunde es je Schweregrad gibt, ohne Açaí zu öffnen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Runs a codebase's quality check and answers with whether it passed and how many findings there are by severity, without opening Açaí."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécute le contrôle qualité d’une codebase et indique s’il a réussi et combien de résultats il y a par gravité, sans ouvrir Açaí."
          }
        }
      }
    },
    "Intent.RunQualityCheck.Title" : {
      "comment" : "The name of the Run Quality Check action in Shortcuts.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Qualitätsprüfung ausführen"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Run Quality Check"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exécuter le contrôle qualité"
          }
        }
      }
    },
