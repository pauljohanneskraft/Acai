    "Intent.ReindexCodebase.Description" : {
      "comment" : "Shortcuts' description of the Reindex Codebase action.",
      "extractionState" : "manual",
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Indiziert eine Codebase in Açaí neu und schlägt fehl, wenn die Analyse nicht abgeschlossen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reindexes a codebase in Açaí, and fails if the analysis doesn't finish."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Réindexe une codebase dans Açaí, et échoue si l’analyse ne se termine pas."
          }
        }
      }
    },
