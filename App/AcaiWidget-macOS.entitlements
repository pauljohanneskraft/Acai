<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>com.apple.security.app-sandbox</key>
	<true/>
	<!-- The only thing the extension needs: read access to the snapshot the app shares. It parses
	nothing and opens no folder, so it gets neither network nor file access. -->
	<key>com.apple.security.application-groups</key>
	<array>
		<string>group.de.kraftsoftware.Acai</string>
	</array>
</dict>
</plist>
