digraph {
  rankdir=LR;
  fontname="Helvetica";
  fontsize=12;
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  "OrderController.submit(order:Order)" [label="OrderController.submit" fillcolor="#e3f2fd"];
  "OrderRepository.save(Order)" [label="OrderRepository.save" fillcolor="#e3f2fd" color="#2e7d32" penwidth=3];
  "OrderService.place(Order)" [label="OrderService.place" fillcolor="#e3f2fd"];
  "PaymentService.charge(Order)" [label="PaymentService.charge" fillcolor="#e3f2fd"];
  "Validator.validate(Order)" [label="Validator.validate" fillcolor="#e3f2fd"];
  "OrderController.submit(order:Order)" -> "OrderService.place(Order)";
  "OrderController.submit(order:Order)" -> "Validator.validate(Order)";
  "OrderService.place(Order)" -> "OrderRepository.save(Order)" [color="#2e7d32"];
  "OrderService.place(Order)" -> "PaymentService.charge(Order)";
}
