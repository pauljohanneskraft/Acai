digraph {
  label="Call graph";
  labelloc=t;
  rankdir=LR;
  fontname="Helvetica";
  fontsize=12;
  node [shape=box style="rounded,filled" fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  "orders.c:charge_card()" [label="charge_card" fillcolor="#f5f5f5" style="rounded,filled,dashed"];
  "orders.c:place_order()" [label="place_order" fillcolor="#e3f2fd"];
  "orders.c:save_order()" [label="save_order" fillcolor="#f5f5f5" style="rounded,filled,dashed"];
  "orders.c:submit_order()" [label="submit_order" fillcolor="#e3f2fd"];
  "orders.c:validate_order()" [label="validate_order" fillcolor="#f5f5f5" style="rounded,filled,dashed"];
  "orders.c:place_order()" -> "orders.c:charge_card()";
  "orders.c:place_order()" -> "orders.c:save_order()";
  "orders.c:submit_order()" -> "orders.c:place_order()";
  "orders.c:submit_order()" -> "orders.c:validate_order()";
}
