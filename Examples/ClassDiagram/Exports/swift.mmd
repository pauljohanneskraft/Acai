classDiagram
    %% The user's whole collection: every playlist in one place.
    class Swift_Library["Library"] {
        +playlists Array~Playlist~
        +init(playlists Array~Playlist~)
        +addPlaylist(playlist Playlist)
        +playlist(name String) Playlist?
    }
    %% Shared base for every item in the library.
    class Swift_MediaItem["MediaItem"] {
        +title String
        +duration TimeInterval
        +genre Genre
        +init(title String, duration TimeInterval, genre Genre)
        +play()
    }
    %% Anything the player knows how to play.
    class Swift_Playable["Playable"] {
        <<interface>>
        +title String
        +duration TimeInterval
        +play()
    }
    %% A coarse classification for a piece of media.
    class Swift_Genre["Genre"] {
        <<enumeration>>
        pop
        rock
        jazz
        classical
        electronic
        spokenWord
    }
    %% Drives playback over a library. Depends on `Library` and the `Playable` protocol.
    class Swift_Player["Player"] {
        -library Library
        +nowPlaying Playable?
        +init(library Library)
        +play(item Playable)
        +playFirstItem(name String)
    }
    %% An ordered collection of media items the user has curated.
    class Swift_Playlist["Playlist"] {
        <<struct>>
        +name String
        +items Array~MediaItem~
        +totalDuration TimeInterval
        +init(name String, items Array~MediaItem~)
        +add(item MediaItem)
    }
    %% One episode of a podcast.
    class Swift_Podcast["Podcast"] {
        +host String
        +episodeNumber Int
        +init(title String, duration TimeInterval, host String, episodeNumber Int)
        +play()
    }
    %% A single track by an artist.
    class Swift_Song["Song"] {
        +artist String
        +album String?
        +init(title String, duration TimeInterval, genre Genre, artist String, album String?)
        +play()
    }
    Swift_Playable <|.. Swift_MediaItem
    Swift_MediaItem <|-- Swift_Podcast
    Swift_MediaItem <|-- Swift_Song
    Swift_Library o-- "*" Swift_Playlist : playlists
    Swift_MediaItem *-- "1" Swift_Genre : genre
    Swift_Player *-- "1" Swift_Library : library
    Swift_Player *-- "0..1" Swift_Playable : nowPlaying
    Swift_Playlist o-- "*" Swift_MediaItem : items
    Swift_Song ..> Swift_Genre
