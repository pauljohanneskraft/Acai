classDiagram
    %% A coarse classification for a piece of media.
    class Java_medialibrary_Genre["Genre"] {
        <<enumeration>>
        POP
        ROCK
        JAZZ
        CLASSICAL
        ELECTRONIC
        SPOKEN_WORD
    }
    %% The user's whole collection: every playlist in one place.
    class Java_medialibrary_Library["Library"] {
        -playlists List~Playlist~
        +Library(playlists List~Playlist~)
        +playlists() List~Playlist~
        +addPlaylist(playlist Playlist) void
        +playlist(named String) Playlist
    }
    %% Shared base for every item in the library.
    class Java_medialibrary_MediaItem["MediaItem"] {
        -title String
        -duration double
        -genre Genre
        +MediaItem(title String, duration double, genre Genre)
        +title() String
        +duration() double
        +genre() Genre
        +play() void
    }
    %% Anything the player knows how to play.
    class Java_medialibrary_Playable["Playable"] {
        <<interface>>
        ~title() String
        ~duration() double
        ~play() void
    }
    %% Drives playback over a library. Depends on {@link Library} and the {@link Playable} interface.
    class Java_medialibrary_Player["Player"] {
        -library Library
        -nowPlaying Playable
        +Player(library Library)
        +nowPlaying() Playable
        +play(item Playable) void
        +playFirstItem(playlistNamed String) void
    }
    %% An ordered collection of media items the user has curated.
    class Java_medialibrary_Playlist["Playlist"] {
        -name String
        -items List~MediaItem~
        +Playlist(name String, items List~MediaItem~)
        +name() String
        +items() List~MediaItem~
        +totalDuration() double
        +add(item MediaItem) void
    }
    %% One episode of a podcast.
    class Java_medialibrary_Podcast["Podcast"] {
        -host String
        -episodeNumber int
        +Podcast(title String, duration double, host String, episodeNumber int)
        +play() void
    }
    %% A single track by an artist.
    class Java_medialibrary_Song["Song"] {
        -artist String
        -album String
        +Song(title String, duration double, genre Genre, artist String, album String)
        +play() void
    }
    Java_medialibrary_Playable <|.. Java_medialibrary_MediaItem
    Java_medialibrary_MediaItem <|-- Java_medialibrary_Podcast
    Java_medialibrary_MediaItem <|-- Java_medialibrary_Song
    Java_medialibrary_Library o-- "*" Java_medialibrary_Playlist : playlists
    Java_medialibrary_MediaItem *-- "1" Java_medialibrary_Genre : genre
    Java_medialibrary_Player *-- "1" Java_medialibrary_Library : library
    Java_medialibrary_Player *-- "1" Java_medialibrary_Playable : nowPlaying
    Java_medialibrary_Playlist o-- "*" Java_medialibrary_MediaItem : items
    Java_medialibrary_Song ..> Java_medialibrary_Genre
