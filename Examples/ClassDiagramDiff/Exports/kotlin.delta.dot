digraph Acai {
  rankdir=TB;
  compound=true;
  fontname="Helvetica";
  fontsize=12;
  node [shape=none margin=0 fontname="Helvetica" fontsize=12];
  edge [fontname="Helvetica" fontsize=10];
  "root.Account" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="CENTER"><B>Account</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  "root.AdminUser" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="CENTER"><B>AdminUser</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  "root.LegacyAudit" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#c62828"><TR><TD ALIGN="CENTER"><B>LegacyAudit</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT">+ review()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "root.OrderService" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#f9a825"><TR><TD ALIGN="CENTER"><B>OrderService</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ gateway: PaymentGateway<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT">+ place()<BR ALIGN="LEFT"/></TD></TR></TABLE>>];
  "root.PaymentGateway" [label=<<TABLE BORDER="1" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4"><TR><TD ALIGN="CENTER"><B>PaymentGateway</B></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  "root.Receipt" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#2e7d32"><TR><TD ALIGN="CENTER"><B>Receipt</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ total: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  "root.User" [label=<<TABLE BORDER="2" CELLBORDER="0" CELLSPACING="0" CELLPADDING="4" COLOR="#f9a825"><TR><TD ALIGN="CENTER"><B>User</B></TD></TR><HR/><TR><TD ALIGN="LEFT">+ name: String<BR ALIGN="LEFT"/>+ email: String<BR ALIGN="LEFT"/></TD></TR><HR/><TR><TD ALIGN="LEFT"> </TD></TR></TABLE>>];
  "root.AdminUser" -> "root.User" [arrowhead=empty style=solid];
  "root.OrderService" -> "root.PaymentGateway" [dir=back arrowtail=diamond color="#2e7d32" label="gateway" headlabel="1"];
  "root.User" -> "root.Account" [arrowhead=empty style=solid color="#c62828"];
}
