    "View.CodebaseDetailView.FeatureEnvyBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Methoden, die sich mehr für einen anderen Typ interessieren als für ihren eigenen — sie rufen häufiger einen Nachbartyp auf als sich selbst. Feature Envy deutet darauf hin, dass das Verhalten eigentlich zu dem Typ gehört, auf den ständig zugegriffen wird."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Methods more interested in another type than their own — they call into a neighbour more than themselves. Feature envy hints the behaviour belongs on the type it keeps reaching into."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méthodes davantage intéressées par un autre type que par elles-mêmes — elles sollicitent un type voisin plus qu'elles-mêmes. La Feature Envy suggère que le comportement devrait se trouver sur le type qu'elle sollicite sans cesse."
          }
        }
      }
    },
