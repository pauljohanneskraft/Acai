    "Error.PathEscapeGuard.AbsolutePath %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" ist ein absoluter Pfad; nur Pfade relativ zum Stammverzeichnis der Codebase sind erlaubt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" is an absolute path; only paths relative to the codebase root are allowed."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" est un chemin absolu ; seuls les chemins relatifs à la racine de la codebase sont autorisés."
          }
        }
      }
    },
    "Error.PathEscapeGuard.EscapesRoot %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" verweist auf einen Ort außerhalb des Codebase-Verzeichnisses und wurde abgelehnt."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" resolves outside the codebase's directory and was rejected."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%@\" pointe hors du répertoire de la codebase et a été rejeté."
          }
        }
      }
    },
