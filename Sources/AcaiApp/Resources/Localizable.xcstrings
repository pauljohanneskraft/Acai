    "View.CodebaseDetailView.MutablePublicState" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veränderlicher öffentlicher Zustand"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mutable Public State"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "État public mutable"
          }
        }
      }
    },
    "View.CodebaseDetailView.MutablePublicStateBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Öffentlich setzbare gespeicherte Properties. Veränderlicher öffentlicher Zustand bricht die Kapselung: Jeder Aufrufer kann die internen Daten des Typs direkt ändern. Bevorzuge eine schreibgeschützte Freigabe mit eingeschränkten Settern."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Publicly settable stored properties. Mutable public state breaks encapsulation: any caller can change the type's internals directly. Prefer read-only exposure with narrowed setters."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Properties stockées modifiables publiquement. Un état public mutable rompt l'encapsulation : n'importe quel appelant peut modifier directement les composants internes du type. Préférez une exposition en lecture seule avec des setters restreints."
          }
        }
      }
    },
    "View.CodebaseDetailView.NestingDepth" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschachtelungstiefe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nesting Depth"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur d'imbrication"
          }
        }
      }
    },
    "View.CodebaseDetailView.NestingDepthBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe des Baums verschachtelter Typen eines Typs. Tief verschachtelte Typen sind schwerer zu benennen, zu finden und zu verstehen; erwäge, sie auf die oberste Ebene zu heben."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Depth of a type's nested-type tree. Deeply nested types are harder to name, find, and reason about; consider promoting them to the top level."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur de l'arborescence des types imbriqués d'un type. Les types profondément imbriqués sont plus difficiles à nommer, trouver et comprendre ; envisagez de les remonter au niveau supérieur."
          }
        }
      }
    },
    "View.CodebaseDetailView.NumberOfChildrenBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direkte Subtypen/Konformer in der Codebase. Ein breit unterklassifizierter Typ ist ein Knotenpunkt der Hierarchie: Änderungen an ihm wirken sich auf jedes Kind aus, also halte seinen Vertrag stabil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Direct subtypes/conformers in the codebase. A widely-subclassed type is a hierarchy hub: changes to it ripple to every child, so keep its contract stable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sous-types/conformants directs dans la Codebase. Un type largement sous-classé est un hub de hiérarchie : ses changements se répercutent sur chaque enfant, alors gardez son contrat stable."
          }
        }
      }
    },
    "View.CodebaseDetailView.NumberOfPropertiesBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gespeicherte/berechnete Properties eines Typs — die Datenhälfte der Balance zwischen anämisch und Verhalten. Ein Typ, der größtenteils aus Feldern mit wenig Verhalten besteht, ist eine Datenklasse, auf die anderer Code zugreift."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stored/computed properties on a type — the data half of the anemic-vs-behaviour balance. A type that is mostly fields with little behaviour is a data class other code reaches into."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Properties stockées/calculées d'un type — la moitié « données » de l'équilibre anémique/comportement. Un type composé surtout de champs avec peu de comportement est une classe de données dans laquelle le reste du code va piocher."
          }
        }
      }
    },
    "View.CodebaseDetailView.OverrideCountBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Member, die einen geerbten Member überschreiben. Viele Overrides können ein Refused-Bequest-Signal sein — die Subklasse lehnt vieles von dem ab, was sie erbt, was darauf hindeutet, dass sie kein echter Subtyp ist."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Members that override an inherited one. Many overrides can be a refused-bequest signal — the subclass rejecting much of what it inherits, hinting it isn't truly a subtype."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Membres qui redéfinissent un membre hérité. De nombreuses redéfinitions peuvent signaler un refused bequest — la sous-classe rejetant une grande partie de ce qu'elle hérite, ce qui laisse penser qu'elle n'est pas vraiment un sous-type."
          }
        }
      }
    },
    "View.CodebaseDetailView.Overrides" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Overrides"
          }
        },
        "en" : {
