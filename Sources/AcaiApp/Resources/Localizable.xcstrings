    "View.CodebaseDetailView.DeletesDiagramsCachedAnalysis" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dadurch werden seine Diagramme und die zwischengespeicherte Analyse gelöscht. Dies kann nicht rückgängig gemacht werden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This deletes its diagrams and cached analysis. This cannot be undone."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cela supprime ses diagrammes et l'analyse mise en cache. Cette action est irréversible."
          }
        }
      }
    },
    "View.CodebaseDetailView.DistanceBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D = |A + I − 1|: Wie weit ein Modul von Martins idealer Balance aus Abstractness und Stabilität entfernt ist. 0 % liegt auf der Main Sequence; hohe Werte weisen auf die „Zone of Pain\" (konkret + stabil, starr) oder die „Zone of Uselessness\" (abstrakt + instabil, ungenutzt) hin."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D = |A + I − 1|: how far a module sits from Martin's ideal balance of abstractness and stability. 0% is on the main sequence; high values flag the 'zone of pain' (concrete + stable, rigid) or the 'zone of uselessness' (abstract + unstable, unused)."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "D = |A + I − 1| : mesure l'écart d'un module par rapport à l'équilibre idéal entre Abstractness et stabilité selon Martin. 0 % se situe sur la séquence principale ; des valeurs élevées signalent la 'zone de la douleur' (concret + stable, rigide) ou la 'zone de l'inutilité' (abstrait + instable, inutilisé)."
          }
        }
      }
    },
    "View.CodebaseDetailView.DistanceMainSeq" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance (Hauptsequenz)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance (Main Seq.)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distance (séq. principale)"
          }
        }
      }
    },
    "View.CodebaseDetailView.EfferentBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efferente Kopplung (Ce): Wie viele Typen außerhalb des Moduls es benötigt. Ein hoher Ce-Wert bedeutet, dass das Modul weit nach außen greift — anfällig für Änderungen anderswo und schwerer isoliert wiederzuverwenden."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efferent coupling (Ce): how many types outside the module it depends on. High Ce means the module reaches broadly outward — sensitive to changes elsewhere and harder to reuse in isolation."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couplage efférent (Ce) : nombre de types extérieurs au module dont il dépend. Un Ce élevé signifie que le module s'étend largement vers l'extérieur — sensible aux changements ailleurs et plus difficile à réutiliser isolément."
          }
        }
      }
    },
    "View.CodebaseDetailView.EfferentCe" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efferent (Ce)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efferent (Ce)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Efferent (Ce)"
          }
        }
      }
    },
