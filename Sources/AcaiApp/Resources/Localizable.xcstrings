    "View.CodebaseDetailView.CyclomaticComplexity" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyclomatic Complexity"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyclomatic Complexity"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cyclomatic Complexity"
          }
        }
      }
    },
    "View.CodebaseDetailView.CyclomaticComplexityBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Die höchste Cyclomatic Complexity einer einzelnen Methode: 1 + ihre Entscheidungspunkte (Verzweigungen, Schleifen, switch-Fälle, catches), gezählt auf jeder Verschachtelungstiefe. Zeigt die eine komplizierte Methode, die eine reine Methodenanzahl verbirgt — ein erstklassiger Kandidat zum Extrahieren und Testen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "The highest cyclomatic complexity of any single method: 1 + its decision points (branches, loops, switch cases, catches), counted at every nesting depth. Surfaces the one gnarly method that a plain method count hides — a prime target to extract and test."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La Cyclomatic Complexity la plus élevée d'une méthode : 1 + ses points de décision (branches, boucles, cas de switch, catchs), comptés à chaque profondeur d'imbrication. Fait ressortir la méthode compliquée qu'un simple décompte de méthodes masque — une cible de choix pour l'extraire et la tester."
          }
        }
      }
    },
    "View.CodebaseDetailView.DataClassScore" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data-Class-Score"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Data-class Score"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Score data-class"
          }
        }
      }
    },
    "View.CodebaseDetailView.DataClassScoreBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil eines Typs, der Daten statt Verhalten ist (Properties ÷ Properties + Methoden). Ein Typ, der fast nur aus Daten besteht und von außen direkt angesprochen wird, ist ein anämisches Domänenmodell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share of a type that is data rather than behaviour (properties ÷ properties + methods). A type that is nearly all data, reached into from elsewhere, is an anemic domain model."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part d'un type qui relève des données plutôt que du comportement (Properties ÷ Properties + méthodes). Un type presque entièrement composé de données, dans lequel on va piocher depuis l'extérieur, est un modèle de domaine anémique."
          }
        }
      }
    },
    "View.CodebaseDetailView.DeepAndWideBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tiefe-und-Breite-Vererbungsform (Tiefe × Kindklassen). Ein Typ, der sowohl tief abgeleitet als auch breit weitervererbt ist, sitzt an einem fragilen Knotenpunkt der Hierarchie, an dem sich Änderungen in alle Richtungen auswirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deep-and-wide inheritance shape (depth × children). A type both deeply derived and widely subclassed sits at a fragile hierarchy hub where changes ripple in every direction."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Forme d'héritage à la fois profonde et large (profondeur × enfants). Un type à la fois profondément dérivé et largement sous-classé se trouve au centre d'une hiérarchie fragile où les changements se répercutent dans toutes les directions."
          }
        }
      }
    },
