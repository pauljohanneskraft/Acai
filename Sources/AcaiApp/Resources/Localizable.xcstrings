          }
        }
      }
    },
    "View.CodebaseDetailView.ParametersBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Längste Parameterliste unter den Methoden/Initialisierern eines Typs. Lange Parameterlisten sind schwer korrekt aufzurufen und deuten oft auf einen fehlenden Typ hin, der die Argumente bündeln sollte."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Widest parameter list among a type's methods/initializers. Long parameter lists are hard to call correctly and often signal a missing type that should bundle the arguments."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Liste de paramètres la plus large parmi les méthodes/initialiseurs d'un type. Les longues listes de paramètres sont difficiles à appeler correctement et signalent souvent un type manquant qui devrait regrouper les arguments."
          }
        }
      }
    },
    "View.CodebaseDetailView.Properties" : {
