        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "No installed acai-mcp binary was found. Build one with \"swift build --product AcaiMCP\", then run Scripts/mcp_install.sh to install it at the path below — or edit the snippet to point at .build/debug/AcaiMCP for a local build."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
