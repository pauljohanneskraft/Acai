      }
    },
    "View.CodebaseDetailView.PublicSurfaceBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Anteil der Member eines Typs, die public/open sind — seine nach außen sichtbare API-Oberfläche. Eine große Oberfläche bei einem großen Typ legt Interna offen und macht den Typ schwer änderbar, ohne Aufrufer zu brechen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Share of a type's members that are public/open — its outward API surface. A wide surface on a big type leaks internals and makes the type hard to change without breaking callers."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Part des membres d'un type qui sont public/open — sa surface d'API exposée. Une large surface sur un grand type expose ses composants internes et rend le type difficile à modifier sans casser les appelants."
          }
        }
      }
    },
