    "View.CodebaseDetailView.FanOutBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele andere Typen dieser Typ benötigt. Ein hoher Fan-out bedeutet viele Verantwortlichkeiten — schwerer zu ändern und zu testen, und ein Kandidat zum Aufteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many other types this type depends on. High fan-out means many responsibilities — harder to change and test, and a candidate for splitting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre d'autres types dont dépend ce type. Un fan-out élevé signifie de nombreuses responsabilités — plus difficile à modifier et à tester, et un candidat à la scission."
          }
        }
      }
    },
