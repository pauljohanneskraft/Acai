    "View.CodebaseDetailView.Abstractness" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstractness"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstractness"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abstractness"
          }
        }
      }
    },
    "View.CodebaseDetailView.AbstractnessBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A = abstrakte Typen / Typen insgesamt in einem Modul (Interfaces, Protocols, abstrakte Klassen). Hohe Abstractness passt zu einem stabilen, grundlegenden Modul; ein konkretes Modul, von dem viele abhängen, ist starr. Wird über die Distance-from-Main-Sequence-Metrik mit Instability kombiniert."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A = abstract types / total types in a module (interfaces, protocols, abstract classes). High abstractness suits a stable, foundational module; a concrete module heavily depended upon is rigid. Paired with instability via the distance-from-main-sequence metric."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A = types abstraits / total des types dans un module (interfaces, protocols, classes abstraites). Une Abstractness élevée convient à un module stable et fondamental ; un module concret dont dépendent de nombreux autres modules est rigide. Associée à l'Instability via la métrique de distance à la séquence principale."
          }
        }
      }
    },
    "View.CodebaseDetailView.AfferentBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferente Kopplung (Ca): Wie viele Typen außerhalb des Moduls von ihm abhängen. Ein hoher Ca-Wert kennzeichnet ein grundlegendes Modul, auf das sich viele andere verlassen — halte es stabil, da sich Änderungen weit auswirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferent coupling (Ca): how many types outside the module depend on it. High Ca marks a foundational module many others rely on — keep it stable, since changes ripple widely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Couplage afférent (Ca) : nombre de types extérieurs au module qui en dépendent. Un Ca élevé signale un module fondamental dont beaucoup d'autres dépendent — gardez-le stable, car ses changements se répercutent largement."
          }
        }
      }
    },
    "View.CodebaseDetailView.AfferentCa" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferent (Ca)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferent (Ca)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Afferent (Ca)"
          }
        }
      }
    },
