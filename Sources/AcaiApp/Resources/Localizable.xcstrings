    "View.CodebaseDetailView.InheritanceDepth" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vererbungstiefe"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inheritance Depth"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Profondeur d'héritage"
          }
        }
      }
    },
    "View.CodebaseDetailView.InheritanceDepthBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Längste Vererbungs-/Konformitätskette eines Typs. 0–2 ist leicht nachvollziehbar; tiefe Ketten (>5) sind ein Komplexitäts-Smell."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Longest inheritance/conformance chain for a type. 0–2 is easy to follow; deep chains (>5) are a complexity smell."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaîne d'héritage/de conformité la plus longue pour un type. 0–2 est facile à suivre ; les chaînes profondes (>5) sont un signe de complexité excessive."
          }
        }
      }
    },
    "View.CodebaseDetailView.Instability" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instability"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instability"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Instability"
          }
        }
      }
    },
    "View.CodebaseDetailView.InstabilityBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I = Ce / (Ca + Ce): Wie stark ein Modul Änderungen durch seine Abhängigkeiten ausgesetzt ist. 0 % = stabil (wird gebraucht, braucht selbst wenig); 100 % = instabil (braucht viel, wird von nichts gebraucht). Keiner der beiden Werte ist per se schlecht — grundlegende Module sollten stabil sein, Leaf-/App-Module instabil."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I = Ce / (Ca + Ce): how exposed a module is to change from its dependencies. 0% = stable (depended upon, depends on little); 100% = unstable (depends outward, nothing depends on it). Neither is inherently bad — foundational modules should be stable, leaf/app modules unstable."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I = Ce / (Ca + Ce) : degré d'exposition d'un module aux changements de ses dépendances. 0 % = stable (dont on dépend, dépend de peu) ; 100 % = instable (dépend de l'extérieur, rien n'en dépend). Aucun des deux n'est intrinsèquement mauvais — les modules fondamentaux doivent être stables, les modules terminaux/applicatifs instables."
          }
        }
      }
    },
    "View.CodebaseDetailView.LackOfCohesionBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LCOM4-Kohäsion: In wie viele unzusammenhängende Gruppen die Methoden eines Typs zerfallen, wenn man sie über gemeinsame Felder oder Aufrufe verbindet. 1 ist kohäsiv; höhere Werte bedeuten mehrere unabhängige Aufgaben, die eigene Typen verdienen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "LCOM4 cohesion: how many disconnected groups the type's methods fall into once linked by shared fields or calls. 1 is cohesive; higher means several unrelated jobs that want separate types."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cohésion LCOM4 : nombre de groupes déconnectés dans lesquels se répartissent les méthodes du type une fois reliées par des champs ou des appels partagés. 1 est cohésif ; une valeur plus élevée signale plusieurs tâches sans rapport qui mériteraient des types séparés."
          }
        }
      }
    },
