    "View.CIQualityCheckExportSheet.RulesFileOutsideCodebase %@" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Regeldatei liegt nicht im Ordner von %@, ein CI-Checkout hat sie also nicht. Committe eine Kopie ins Repository (z. B. als quality.yml), bevor du den Ausschnitt unten in CI verwendest."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "This rules file isn't inside %@'s own folder, so a CI runner's checkout won't have it. Commit a copy into the repository (e.g. as quality.yml) before using the snippet below in CI."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce fichier de règles n'est pas dans le dossier de %@ ; le checkout d'un runner CI ne l'aura donc pas. Committez-en une copie dans le repository (par ex. comme quality.yml) avant d'utiliser l'extrait ci-dessous en CI."
          }
        }
      }
    },
