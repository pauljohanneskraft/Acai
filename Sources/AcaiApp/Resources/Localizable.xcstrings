    "View.CodebaseDetailView.WeightedMethodsBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weighted Methods per Type (Methodenanzahl). Große Typen tragen viele Verantwortlichkeiten (Risiko geringer Kohäsion / SRP) und sind erstklassige Kandidaten zum Aufteilen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Weighted methods per type (method count). Large types carry many responsibilities (low cohesion / SRP risk) and are prime candidates for splitting."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Méthodes pondérées par type (nombre de méthodes). Les grands types portent de nombreuses responsabilités (risque de faible cohésion / SRP) et sont des candidats de choix pour la scission."
          }
        }
      }
    },
