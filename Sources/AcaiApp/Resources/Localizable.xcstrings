    "View.CodebaseDetailView.FanInBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wie viele Typen von diesem Typ abhängen. Ein hoher Fan-in kennzeichnet einen zentralen Typ/Hub; das ist bei gemeinsam genutzten Modellen zu erwarten, aber halte sie stabil und gut getestet, da sich Änderungen weit auswirken."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "How many types depend on this type. High fan-in marks a core/hub type; expected for shared models, but keep them stable and well-tested since changes ripple widely."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nombre de types qui dépendent de ce type. Un fan-in élevé signale un type central/hub ; attendu pour les modèles partagés, mais gardez-les stables et bien testés, car les changements s'y répercutent largement."
          }
        }
      }
    },
    "View.CodebaseDetailView.FanOut" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fan-out"
