    "View.CodebaseDetailView.ResponseForClassBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response For a Class: die von einem Typ deklarierten Methoden plus die eindeutigen Methoden, die er aufruft. Eine große Response-Menge bedeutet, dass als Reaktion auf eine Nachricht viel passieren kann — aufwendig zu testen und zu verstehen."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response For a Class: the methods a type declares plus the distinct methods it calls. A large response set means a lot can happen in reaction to one message — costly to test and reason about."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response For a Class : les méthodes qu'un type déclare plus les méthodes distinctes qu'il appelle. Un grand ensemble de réponses signifie que beaucoup de choses peuvent se produire en réaction à un seul message — coûteux à tester et à comprendre."
          }
        }
      }
    },
    "View.CodebaseDetailView.ResponseRFC" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response (RFC)"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response (RFC)"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Response (RFC)"
          }
        }
      }
    },
    "View.CodebaseDetailView.SdpBlurb" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verstöße gegen das Stable-Dependencies-Principle: Module, von denen dieses Modul abhängt und die *weniger* stabil sind als es selbst — eine Abhängigkeit von etwas, das sich eher ändert als man selbst, sodass sich Änderungen nach oben fortpflanzen. Kein Zyklus, daher übersieht die Zykluserkennung dies. Tippe für die betroffenen Module."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stable-Dependencies-Principle breaches: modules this one depends on that are *less* stable than it — a dependency on something likelier to change than you, so edits ripple up. Not a cycle, so cycle detection misses it. Tap for the offending modules."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Violations du Stable-Dependencies-Principle : modules dont celui-ci dépend et qui sont *moins* stables que lui — une dépendance vers quelque chose de plus susceptible de changer que vous, ce qui fait remonter les répercussions des modifications. Ce n'est pas un cycle, donc la détection de cycles ne le repère pas. Appuyez pour voir les modules en cause."
          }
        }
      }
    },
    "View.CodebaseDetailView.SDPBreaches" : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDP-Verstöße"
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "SDP Breaches"
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Violations SDP"
          }
        }
      }
    },
